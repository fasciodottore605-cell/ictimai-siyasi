                      </span>
                      <span class="text-sm sm:text-base font-semibold leading-snug flex-1">
                        ${escapeHtml(opt)}
                      </span>
                      ${
                        hasAnswered && isCorrectOpt
                          ? `<span class="text-emerald-600 dark:text-emerald-400 font-extrabold text-base shrink-0">✓</span>`
                          : hasAnswered && isSelected && !isCorrectOpt
                          ? `<span class="text-rose-600 dark:text-rose-400 font-extrabold text-base shrink-0">✕</span>`
                          : ""
                      }
                    </button>
                  `;
                })
                .join("")}
            </div>

            <!-- Feedback & Next Button -->
            ${
              state.quizSelectedOption !== null
                ? `
                  <div class="mt-6 pt-5 border-t border-slate-100 dark:border-slate-800 flex flex-col sm:flex-row sm:items-center justify-between gap-4">
                    <div>
                      ${
                        state.quizIsCorrect
                          ? `<div class="text-sm font-bold text-emerald-600 dark:text-emerald-400">✓ Doğru cavab! Sual öyrənilmiş kimi qeyd olundu.</div>`
                          : `<div class="text-sm font-bold text-rose-600 dark:text-rose-400">✕ Səhv cavab! Sual «Təkrar / Səhv» siyahısına əlavə olundu.</div>
                             <div class="text-xs text-slate-600 dark:text-slate-300 mt-1">Doğru cavab: <strong>${escapeHtml(q.a)}</strong></div>`
                      }
                    </div>

                    <button
                      id="next-quiz-btn"
                      type="button"
                      class="inline-flex items-center justify-center gap-2 px-5 py-3 rounded-2xl text-sm font-bold bg-blue-600 hover:bg-blue-700 text-white shadow-sm transition-colors cursor-pointer shrink-0"
                    >
                      <span>Növbəti sual</span>
                      <span>→</span>
                    </button>
                  </div>
                `
                : `
                  <div class="mt-6 flex justify-end">
                    <button
                      id="skip-quiz-btn"
                      type="button"
                      class="px-4 py-2 rounded-xl text-xs font-semibold text-slate-500 dark:text-slate-400 hover:text-slate-800 dark:hover:text-slate-200 hover:bg-slate-100 dark:hover:bg-slate-800 transition-colors cursor-pointer"
                    >
                      Bu sualı keç →
                    </button>
                  </div>
                `
            }
          </div>
        </div>
      `;
    }

