      onlyReview: false, // Mistakes / Hard / Review filter
      searchQuery: "",
      // Flashcard state
      cardIndex: 0,
      isFlipped: false,
      shuffleCards: false,
      shuffledOrder: [],
      // Quiz state
      quizQuestion: null,
      quizOptions: [],
      quizSelectedOption: null,
      quizIsCorrect: null,
      quizRecentIds: [],
      // Browse state
      expandedBrowseIds: {},
      // Toast notification
      toast: null,
      // User progress
      progress: loadProgress()
    };

    const categories = [
      "Hamısı",
      ...Array.from(new Set(QUESTIONS_DATA.map((item) => item.cat)))
    ];

    const ranges = [
      { id: "all", label: "Bütün suallar (1–255)" },
      { id: "1-50", label: "№ 1–50" },
      { id: "51-100", label: "№ 51–100" },
      { id: "101-150", label: "№ 101–150" },
      { id: "151-200", label: "№ 151–200" },
      { id: "201-255", label: "№ 201–255" }
    ];

    function showToast(message, type = "info") {
      state.toast = { message, type };
      render();
      clearTimeout(window.__toastTimer);
      window.__toastTimer = setTimeout(() => {
        state.toast = null;
        render();
      }, 2800);
    }

    function matchesRange(id, rangeId) {
      if (rangeId === "all") return true;
      const [min, max] = rangeId.split("-").map(Number);
      return id >= min && id <= max;
    }

    function getFilteredQuestions(ignoreSearch = false) {
      return QUESTIONS_DATA.filter((item) => {
        if (state.category !== "Hamısı" && item.cat !== state.category) {
          return false;
        }
        if (!matchesRange(item.id, state.range)) {
          return false;
        }
        if (state.onlyReview) {
          const inMistakes = state.progress.mistakeIds.includes(item.id);
          const notLearned = !state.progress.learnedIds.includes(item.id);
          if (!inMistakes && !notLearned) return false;
        }
        if (!ignoreSearch && state.searchQuery.trim() !== "") {
          const q = state.searchQuery.trim().toLowerCase();
          const matchNum = String(item.id) === q;
          const matchQ = item.q.toLowerCase().includes(q);
          const matchA = item.a.toLowerCase().includes(q);
          const matchCat = item.cat.toLowerCase().includes(q);
          if (!matchNum && !matchQ && !matchA && !matchCat) return false;
        }
        return true;
      });
    }

    function getOrderedFlashcards() {
      const filtered = getFilteredQuestions(false);
      if (!state.shuffleCards) {
        return filtered;
      }
      const mapById = new Map(filtered.map((q) => [q.id, q]));
      const ordered = [];
      for (const id of state.shuffledOrder) {
        if (mapById.has(id)) {
          ordered.push(mapById.get(id));
          mapById.delete(id);
        }
      }
      // Add any remaining items that weren't in shuffledOrder
      for (const q of mapById.values()) {
        ordered.push(q);
      }
      return ordered;
    }

    function generateShuffledOrder() {
      const ids = getFilteredQuestions(false).map((q) => q.id);
      for (let i = ids.length - 1; i > 0; i--) {
        const j = Math.floor(Math.random() * (i + 1));
        [ids[i], ids[j]] = [ids[j], ids[i]];
      }
      state.shuffledOrder = ids;
      state.cardIndex = 0;
      state.isFlipped = false;
    }

    // Build multiple-choice options for a target question
    function buildQuizQuestion() {
      const pool = getFilteredQuestions(true).filter(
        (q) => q.a && !q.a.toLowerCase().includes("şəkildə cavab qeyd olunmayıb")
      );

      if (pool.length === 0) {
        state.quizQuestion = null;
        state.quizOptions = [];
        state.quizSelectedOption = null;
        state.quizIsCorrect = null;
        return;
      }

      // Prefer questions not recently seen
      const unseen = pool.filter((q) => !state.quizRecentIds.includes(q.id));
      const candidates = unseen.length > 0 ? unseen : pool;
      const target = candidates[Math.floor(Math.random() * candidates.length)];

      state.quizRecentIds = [...state.quizRecentIds.slice(-18), target.id];

      // Distractors from same category first, then global pool
      const sameCat = QUESTIONS_DATA.filter(
        (q) =>
          q.id !== target.id &&
          q.cat === target.cat &&
          q.a &&
          !q.a.toLowerCase().includes("şəkildə cavab qeyd olunmayıb") &&
          q.a.trim().toLowerCase() !== target.a.trim().toLowerCase()
      );

      const otherPool = QUESTIONS_DATA.filter(
        (q) =>
          q.id !== target.id &&
          q.a &&
          !q.a.toLowerCase().includes("şəkildə cavab qeyd olunmayıb") &&
          q.a.trim().toLowerCase() !== target.a.trim().toLowerCase()
      );

      const distractors = [];
      const usedAnswers = new Set([target.a.trim().toLowerCase()]);

      function pickFrom(list) {
        const copy = [...list];
        for (let i = copy.length - 1; i > 0; i--) {
          const j = Math.floor(Math.random() * (i + 1));
          [copy[i], copy[j]] = [copy[j], copy[i]];
        }
        for (const item of copy) {
          if (distractors.length >= 3) break;
          const norm = item.a.trim().toLowerCase();
          if (!usedAnswers.has(norm)) {
            usedAnswers.add(norm);
            distractors.push(item.a);
          }
        }
      }

      pickFrom(sameCat);
      pickFrom(otherPool);

      const options = [target.a, ...distractors];
      for (let i = options.length - 1; i > 0; i--) {
        const j = Math.floor(Math.random() * (i + 1));
        [options[i], options[j]] = [options[j], options[i]];
      }

      state.quizQuestion = target;
      state.quizOptions = options;
      state.quizSelectedOption = null;
      state.quizIsCorrect = null;
    }

    function handleSelectQuizOption(optionText) {
      if (!state.quizQuestion || state.quizSelectedOption !== null) return;
      const qId = state.quizQuestion.id;
      const isCorrect = optionText === state.quizQuestion.a;

      state.quizSelectedOption = optionText;
      state.quizIsCorrect = isCorrect;

      state.progress.quizStats.answered += 1;
      if (isCorrect) {
        state.progress.quizStats.correct += 1;
        state.progress.mistakeIds = state.progress.mistakeIds.filter((id) => id !== qId);
        if (!state.progress.learnedIds.includes(qId)) {
          state.progress.learnedIds.push(qId);
        }
      } else {
        if (!state.progress.mistakeIds.includes(qId)) {
          state.progress.mistakeIds.push(qId);
        }
      }
      saveProgress(state.progress);
      render();
    }

    function markCardLearned(qId) {
      if (!state.progress.learnedIds.includes(qId)) {
        state.progress.learnedIds.push(qId);
      }
      state.progress.mistakeIds = state.progress.mistakeIds.filter((id) => id !== qId);
      saveProgress(state.progress);
      showToast(`№${qId} sualı öyrənilmiş kimi qeyd edildi`, "success");
    }

    function markCardHard(qId) {
      if (!state.progress.mistakeIds.includes(qId)) {
        state.progress.mistakeIds.push(qId);
      }
      state.progress.learnedIds = state.progress.learnedIds.filter((id) => id !== qId);
      saveProgress(state.progress);
      showToast(`№${qId} sualı təkrar siyahısına əlavə olundu`, "warning");
    }

    function toggleReviewStatus(qId) {
      const idx = state.progress.mistakeIds.indexOf(qId);
      if (idx >= 0) {
        state.progress.mistakeIds.splice(idx, 1);
        showToast(`№${qId} təkrar siyahısından çıxarıldı`, "info");
      } else {
        state.progress.mistakeIds.push(qId);
        showToast(`№${qId} təkrar siyahısına əlavə edildi`, "warning");
      }
      saveProgress(state.progress);
      render();
    }

    function resetProgress() {
      state.progress = {
        learnedIds: [],
        mistakeIds: [],
        quizStats: { answered: 0, correct: 0 }
      };
      saveProgress(state.progress);
      showToast("Bütün tərəqqi sıfırlandı", "info");
      render();
    }

    function escapeHtml(str) {
      return String(str)
        .replace(/&/g, "&amp;")
        .replace(/</g, "&lt;")
        .replace(/>/g, "&gt;")
        .replace(/"/g, "&quot;")
        .replace(/'/g, "&#039;");
    }

