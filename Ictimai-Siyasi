    function renderToast() {
      if (!state.toast) return "";
      const colors =
        state.toast.type === "success"
          ? "bg-emerald-600 text-white"
          : state.toast.type === "warning"
          ? "bg-amber-600 text-white"
          : "bg-slate-900 dark:bg-slate-100 text-white dark:text-slate-900";

      return `
        <div class="fixed bottom-5 right-5 z-50 max-w-sm">
          <div class="px-4 py-3 rounded-2xl shadow-lg text-xs sm:text-sm font-semibold ${colors}">
            ${escapeHtml(state.toast.message)}
          </div>
        </div>
      `;
    }

    function render() {
      const appEl = document.getElementById("app");
      const filtered = getFilteredQuestions(false);

      let modeContent = "";
      if (state.mode === "flashcards") {
        modeContent = renderFlashcardsMode();
      } else if (state.mode === "quiz") {
        modeContent = renderQuizMode();
      } else {
        modeContent = renderBrowseMode();
      }

      appEl.innerHTML = `
        ${renderHeader()}
        ${renderFilters(filtered.length)}
        <main class="flex-1 flex flex-col">
          ${modeContent}
        </main>
        <footer class="max-w-6xl w-full mx-auto px-4 sm:px-6 py-6 text-center text-xs text-slate-400 dark:text-slate-500">
          İctimai-siyasi hazırlıq test materialları əsasında hazırlanmış tədris və özünü yoxlama proqramı.
        </footer>
        ${renderToast()}
      `;

      bindEvents();
    }

    function resetAllFilters() {
      state.category = "Hamısı";
      state.range = "all";
      state.onlyReview = false;
      state.searchQuery = "";
      state.cardIndex = 0;
      state.isFlipped = false;
      if (state.shuffleCards) generateShuffledOrder();
      if (state.mode === "quiz") buildQuizQuestion();
      render();
    }

    function bindEvents() {
      // Mode buttons
      document.getElementById("mode-flashcards")?.addEventListener("click", () => {
        state.mode = "flashcards";
        state.cardIndex = 0;
        state.isFlipped = false;
        if (state.shuffleCards) generateShuffledOrder();
        render();
      });

      document.getElementById("mode-quiz")?.addEventListener("click", () => {
        state.mode = "quiz";
        buildQuizQuestion();
        render();
      });

      document.getElementById("mode-browse")?.addEventListener("click", () => {
        state.mode = "browse";
        render();
      });

      document.getElementById("reset-progress-btn")?.addEventListener("click", () => {
        resetProgress();
      });

      // Filter controls
      document.getElementById("filter-category")?.addEventListener("change", (e) => {
        state.category = e.target.value;
        state.cardIndex = 0;
        state.isFlipped = false;
        if (state.shuffleCards) generateShuffledOrder();
        if (state.mode === "quiz") buildQuizQuestion();
        render();
      });

      document.getElementById("filter-range")?.addEventListener("change", (e) => {
        state.range = e.target.value;
        state.cardIndex = 0;
        state.isFlipped = false;
        if (state.shuffleCards) generateShuffledOrder();
        if (state.mode === "quiz") buildQuizQuestion();
        render();
      });

      const searchInput = document.getElementById("filter-search");
      searchInput?.addEventListener("input", (e) => {
        state.searchQuery = e.target.value;
        state.cardIndex = 0;
        state.isFlipped = false;
        render();
        // Restore focus and caret position after re-render
        const restored = document.getElementById("filter-search");
        if (restored) {
          restored.focus();
          const len = restored.value.length;
          restored.setSelectionRange(len, len);
        }
      });

      document.getElementById("clear-search-btn")?.addEventListener("click", () => {
        state.searchQuery = "";
        state.cardIndex = 0;
        render();
      });

      document.getElementById("toggle-review-filter")?.addEventListener("click", () => {
        state.onlyReview = !state.onlyReview;
        state.cardIndex = 0;
        state.isFlipped = false;
        if (state.shuffleCards) generateShuffledOrder();
        if (state.mode === "quiz") buildQuizQuestion();
        render();
      });

      document.getElementById("clear-all-filters")?.addEventListener("click", resetAllFilters);
      document.getElementById("empty-reset-btn")?.addEventListener("click", resetAllFilters);

      // Flashcard events
      const cards = getOrderedFlashcards();
      const currentCard = cards[state.cardIndex];

      document.getElementById("shuffle-cards-btn")?.addEventListener("click", () => {
        state.shuffleCards = !state.shuffleCards;
        if (state.shuffleCards) {
          generateShuffledOrder();
          showToast("Kartlar təsadüfi sıraya düzüldü", "info");
        } else {
          state.cardIndex = 0;
          state.isFlipped = false;
          showToast("Ardıcıl sıra bərpa olundu", "info");
        }
        render();
      });

      const flipAction = () => {
        state.isFlipped = !state.isFlipped;
        render();
      };

      document.getElementById("flashcard-inner")?.addEventListener("click", flipAction);
      document.getElementById("flashcard-inner")?.addEventListener("keydown", (e) => {
        if (e.key === "Enter" || e.key === " ") {
          e.preventDefault();
          flipAction();
        }
      });
      document.getElementById("flip-card-btn")?.addEventListener("click", flipAction);

      document.getElementById("prev-card-btn")?.addEventListener("click", () => {
        if (cards.length === 0) return;
        state.cardIndex = (state.cardIndex - 1 + cards.length) % cards.length;
        state.isFlipped = false;
        render();
      });

      document.getElementById("next-card-btn")?.addEventListener("click", () => {
        if (cards.length === 0) return;
        state.cardIndex = (state.cardIndex + 1) % cards.length;
        state.isFlipped = false;
        render();
      });

      if (currentCard) {
        document.getElementById("mark-hard-btn")?.addEventListener("click", () => {
          markCardHard(currentCard.id);
          render();
        });

        document.getElementById("mark-learned-btn")?.addEventListener("click", () => {
          markCardLearned(currentCard.id);
          if (cards.length > 1) {
            state.cardIndex = (state.cardIndex + 1) % cards.length;
            state.isFlipped = false;
          }
          render();
        });
      }

      // Quiz events
      document.querySelectorAll(".quiz-option-btn").forEach((btn) => {
        btn.addEventListener("click", () => {
          const val = btn.getAttribute("data-quiz-option");
          if (val !== null) {
            handleSelectQuizOption(val);
          }
        });
      });

      document.getElementById("next-quiz-btn")?.addEventListener("click", () => {
        buildQuizQuestion();
        render();
      });

      document.getElementById("skip-quiz-btn")?.addEventListener("click", () => {
        buildQuizQuestion();
        render();
      });

      // Browse mode events
      document.getElementById("expand-all-btn")?.addEventListener("click", () => {
        const list = getFilteredQuestions(false);
        const nextMap = { ...state.expandedBrowseIds };
        list.forEach((item) => {
          nextMap[item.id] = true;
        });
        state.expandedBrowseIds = nextMap;
        render();
      });

      document.getElementById("collapse-all-btn")?.addEventListener("click", () => {
        const list = getFilteredQuestions(false);
        const nextMap = { ...state.expandedBrowseIds };
        list.forEach((item) => {
          delete nextMap[item.id];
        });
        state.expandedBrowseIds = nextMap;
        render();
      });

      document.querySelectorAll(".browse-answer-btn").forEach((btn) => {
        btn.addEventListener("click", () => {
          const id = Number(btn.getAttribute("data-toggle-answer"));
          state.expandedBrowseIds[id] = !state.expandedBrowseIds[id];
          render();
        });
      });

      document.querySelectorAll(".browse-review-btn").forEach((btn) => {
        btn.addEventListener("click", () => {
          const id = Number(btn.getAttribute("data-toggle-review"));
          toggleReviewStatus(id);
        });
      });

      document.querySelectorAll(".browse-learned-btn").forEach((btn) => {
        btn.addEventListener("click", () => {
          const id = Number(btn.getAttribute("data-mark-learned-browse"));
          markCardLearned(id);
          render();
        });
      });
    }

    // Global keyboard shortcuts for flashcards & quiz
    document.addEventListener("keydown", (e) => {
      const tag = document.activeElement?.tagName?.toLowerCase();
      if (tag === "input" || tag === "select" || tag === "textarea") return;

      if (state.mode === "flashcards") {
        const cards = getOrderedFlashcards();
        if (cards.length === 0) return;

        if (e.key === "ArrowRight") {
          e.preventDefault();
          state.cardIndex = (state.cardIndex + 1) % cards.length;
          state.isFlipped = false;
          render();
        } else if (e.key === "ArrowLeft") {
          e.preventDefault();
          state.cardIndex = (state.cardIndex - 1 + cards.length) % cards.length;
          state.isFlipped = false;
          render();
        } else if (e.key === " ") {
          e.preventDefault();
          state.isFlipped = !state.isFlipped;
          render();
        }
      } else if (state.mode === "quiz" && state.quizSelectedOption !== null) {
        if (e.key === "Enter" || e.key === "ArrowRight") {
          e.preventDefault();
          buildQuizQuestion();
          render();
        }
      }
    });

    // Initial render
    buildQuizQuestion();
    render();
  </script>
</body>
</html>
