                          № ${item.id}
                        </span>
                        <div>
                          <div class="flex flex-wrap items-center gap-1.5 mb-1">
                            <span class="text-[11px] font-semibold text-blue-600 dark:text-blue-400">
                              ${escapeHtml(item.cat)}
                            </span>
                            ${
                              isLearned
                                ? `<span class="px-2 py-0.5 rounded-full text-[10px] font-bold bg-emerald-100 dark:bg-emerald-950 text-emerald-800 dark:text-emerald-300">Öyrənilib</span>`
                                : ""
                            }
                            ${
