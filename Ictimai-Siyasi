                      </div>
                    </div>

                    ${
                      isOpen
                        ? `
                          <div class="mt-3.5 pt-3.5 border-t border-slate-100 dark:border-slate-800 flex flex-col sm:flex-row sm:items-center justify-between gap-3 bg-emerald-50/60 dark:bg-emerald-950/25 rounded-xl p-3.5">
                            <div class="text-sm font-bold text-emerald-950 dark:text-emerald-200">
                              <span class="text-xs uppercase tracking-wider font-extrabold text-emerald-700 dark:text-emerald-400 mr-1.5">Cavab:</span>
                              ${escapeHtml(item.a)}
                            </div>
                            <button
                              type="button"
                              data-mark-learned-browse="${item.id}"
                              class="browse-learned-btn self-start sm:self-center px-3 py-1.5 rounded-xl text-xs font-bold bg-emerald-600 hover:bg-emerald-700 text-white transition-colors cursor-pointer shrink-0"
