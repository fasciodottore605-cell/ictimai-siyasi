    const STORAGE_KEY = "ictimai_siyasi_hazirliq_progress_v1";

    // Default persisted progress structure
    function loadProgress() {
      try {
        const raw = localStorage.getItem(STORAGE_KEY);
        if (!raw) {
          return {
            learnedIds: [],
            mistakeIds: [],
            quizStats: { answered: 0, correct: 0 }
          };
        }
        const parsed = JSON.parse(raw);
        return {
          learnedIds: Array.isArray(parsed.learnedIds) ? parsed.learnedIds : [],
          mistakeIds: Array.isArray(parsed.mistakeIds) ? parsed.mistakeIds : [],
          quizStats: {
            answered: Number(parsed.quizStats?.answered) || 0,
            correct: Number(parsed.quizStats?.correct) || 0
          }
        };
      } catch (e) {
        return {
          learnedIds: [],
          mistakeIds: [],
          quizStats: { answered: 0, correct: 0 }
        };
      }
    }

    function saveProgress(progress) {
      try {
        localStorage.setItem(STORAGE_KEY, JSON.stringify(progress));
      } catch (e) {
        // Ignore storage quota errors safely
      }
    }

