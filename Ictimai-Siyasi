                  return `
                    <button
                      type="button"
                      data-quiz-option="${escapeHtml(opt)}"
                      ${hasAnswered ? "disabled" : ""}
                      class="quiz-option-btn w-full text-left p-4 rounded-2xl border transition-all flex items-start gap-3.5 ${btnClass} ${
                        hasAnswered ? "cursor-default" : "cursor-pointer"
