                      </div>

                      <div class="flex items-center gap-2 shrink-0 sm:ml-2">
                        <button
                          type="button"
                          data-toggle-review="${item.id}"
                          title="Təkrar siyahısına əlavə et / çıxar"
                          class="browse-review-btn px-2.5 py-1.5 rounded-xl text-xs font-semibold border transition-colors cursor-pointer ${
                            isMistake
                              ? "bg-amber-500 text-white border-amber-600"
                              : "bg-slate-50 dark:bg-slate-800 text-slate-600 dark:text-slate-300 border-slate-200 dark:border-slate-700 hover:bg-amber-50 dark:hover:bg-amber-950/40"
                          }"
                        >
                          ⚠️
                        </button>
                        <button
                          type="button"
